<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ReadyTypingSetup</AssemblyName>
    <RootNamespace>ReadyTypingSetup</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Ready Typing Setup</Product>
    <AssemblyTitle>Ready Typing Setup</AssemblyTitle>
    <Description>Installer for the Ready Typing Bengali Bijoy trainer.</Description>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      Version="1.0.3"
                      PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by build-setup.ps1 before this project is compiled. -->
    <EmbeddedResource Include="Payload\ReadyTyping.exe.gz"
                      LogicalName="ReadyTypingSetup.Payload.ReadyTyping.exe.gz" />
    <EmbeddedResource Include="Resources\app.ico"
                      LogicalName="ReadyTypingSetup.Resources.app.ico" />
    <EmbeddedResource Include="Resources\logo.png"
                      LogicalName="ReadyTypingSetup.Resources.logo.png" />
  </ItemGroup>

</Project>
